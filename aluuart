module alu ( input [7:0] data1 , input [7:0] data2 , output reg [7:0] result , input [1:0] operation );
always @ (*)
begin 
    case(operation)
    2'b00 : result = data1 +  data2 ;
    2'b01 : result = data1 - data2;
    2'b10 :  result = data1 * data2;
    2'b11 : result = (data2 != 0 )? data1 % data2 : 8'b0  ;
    default : result = 8'b0 ;
    endcase 
end 
endmodule 

module uartpalu (
    output tx,
    input clk,
    input rst,
    input rx
);


wire tick, half_tick;
baud_rate br1 (
    .clk(clk),
    .rst(rst),
   .tick(tick),
    .half_tick(half_tick), 
);

wire [7:0] rx_data;
wire rx_done;

rx rx1 (
    .clk(clk),
    .rst(rst),
    .rx(rx),
    .data_out(rx_data),
    .done(rx_done)
);


reg [7:0] data1, data2;
reg [1:0] operation;
wire [7:0] result;

alu alu1 (
    .data1(data1),
    .data2(data2),
    .operation(operation),
    .result(result)
);


reg [7:0] tx_input;
reg start1;
wire tx_dout;

tx tx1 (
    .clk(clk),
    .rst(rst),
    .data_in(tx_input),
      .tick(tick),  
    .start(start1),
    .dout(tx_dout)
);

assign tx = tx_dout;


reg [2:0] state, next_state;

parameter s0 = 3'b000;
parameter s1 = 3'b001;
parameter s2 = 3'b010;
parameter s3 = 3'b011;
parameter s4 = 3'b100;


always @(posedge clk or posedge rst) begin
    if (rst)
        state <= s0;
    else
        state <= next_state;
end


always @(*) begin
    case (state)
        s0: next_state = (rx_done) ? s1 : s0;
        s1: next_state = (rx_done) ? s2 : s1;
        s2: next_state = (rx_done) ? s3 : s2;
        s3: next_state = s4;
        s4: next_state = s0;
        default: next_state = s0;
    endcase
end


reg s4_d;
wire start_pulse;

assign start_pulse = (state == s4) & ~s4_d;

always @(posedge clk or posedge rst) begin
    if (rst)
        s4_d <= 0;
    else
        s4_d <= (state == s4);
end


always @(posedge clk or posedge rst) begin
    if (rst) begin
        start1   <= 0;
        data1    <= 0;
        data2    <= 0;
        operation<= 0;
        tx_input <= 0;
    end 
    else begin
        start1 <= start_pulse;

        if (state == s0 && rx_done)
            data1 <= rx_data;

        if (state == s1 && rx_done)
            data2 <= rx_data;

        if (state == s2 && rx_done)
            operation <= rx_data[1:0];

        if (state == s4)
            tx_input <= result;
    end
end

endmodule
