module tx (
    input clk,
    input rst,
    input [7:0] data_in,
    input start,
    input tick,
    output reg dout,
    output reg busy
);

parameter s0 = 2'b00; // initial begun
parameter s1 = 2'b01; // start 
parameter s2 = 2'b10; // data
parameter s3 = 2'b11; // stop

reg [1:0] state, next_state;
reg [2:0] bit_index;
reg [7:0] shift_reg;



always @(posedge clk or posedge rst) begin
    if (rst)
        state <= s0;
    else
        state <= next_state;
end

always @(*) begin
    case (state)
        s0: next_state = (start) ? s1 : s0;
        s1: next_state = (tick) ? s2 : s1;
        s2: next_state = (tick && bit_index == 7) ? s3 : s2;
        s3: next_state = (tick) ? s0 : s3;
        default: next_state = s0;
    endcase
end
always @(*) begin
    case (state)
        s0: begin
         dout = 1; busy = 0;
          end  
        s1: begin 
        dout = 0; busy = 1; 
        end   
        s2: begin
         dout = shift_reg[bit_index]; busy = 1;
          end 
        s3: begin 
        dout = 1; busy = 1;
         end  
        default: begin dout = 1; busy = 0; end
    endcase
end
always @(posedge clk or posedge rst) begin
    if (rst) begin
        bit_index <= 0;
        shift_reg <= 0;
    end else begin
        case (state)

            s0: begin
                if (start && state == s0) begin
                    shift_reg <= data_in;
                    bit_index <= 0;
                end
            end

            s2: begin
                if (tick) begin
                    if (bit_index == 7)
                        bit_index <= 0;
                    else
                        bit_index <= bit_index + 1;
                end
            end

        endcase
    end

end

endmodule
